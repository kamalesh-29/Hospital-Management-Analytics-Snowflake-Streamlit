# .streamlit/secrets.toml
# Copy this file as 'secrets.toml' and replace with your actual Snowflake credentials
# NEVER push the real secrets.toml to GitHub!

[snowflake]
user = "your_username"
password = "your_password"
account = "your_account_identifier"   # e.g., xy12345.ap-southeast-1
warehouse = "HOSPITAL_WH"
database = "HOSPITAL_DW"
schema = "MART"
role = "HOSPITAL_ANALYST_ROLE"
